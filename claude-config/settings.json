{
  "cleanupPeriodDays": 99999,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "MultiEdit",
      "Edit",
      "Write",
      "LS",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:arxiv.org)",
      "WebFetch(domain:deepwiki.com)",
      "WebFetch(domain:pytorch.org)",
      "WebFetch(domain:medium.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(ggrep *)",
      "Bash(find *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(/usr/bin/grep *)",
      "Bash(whoami)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(whoami)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tmux capture-pane:*)",
      "Bash(~/.claude/scripts/tmux-exec.sh:*)",
      "Bash(~/.claude/scripts/tmux-capture.sh:*)",
      "Bash(~/.claude/scripts/cc-shot.sh:*)",
      "Bash(python ~/.claude/scripts/preset_switch.py:*)",
      "Bash(~/Applications/bin/cc-bridge-toggle-globally)",
      "Bash(~/Applications/bin/cc-bridge-toggle-globally *)",
      "Bash(~/Applications/bin/cc-bridge-toggle)",
      "Bash(~/Applications/bin/cc-bridge-toggle *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.zshenv)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)"
    ]
  },
  "skillOverrides": {
    "stop-slop": "user-invocable-only",
    "stop-slop-zh": "user-invocable-only",
    "paper-recipe": "user-invocable-only",
    "paper-audit": "user-invocable-only",
    "hf-cli": "name-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/hooks/audit_edit.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-tmux.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/enforce-shot.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/skill-gate.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh pretool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-changes-log.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh posttool"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh prompt-submit"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/roster-reminder.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh stop"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/status-check.sh"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh stop-failure"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-bridge-hook.sh permreq"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/subagent-rules.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/english-daily.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "telegram@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "paddle@claude-community": true,
    "hookify@claude-plugins-official": true,
    "session-report@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "spinnerTipsEnabled": false,
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-2": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "switchModelsOnFlag": true,
  "agentPushNotifEnabled": true
}
